<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>InternHub — Login</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet"/>
<style>
:root{--bg:#060d1f;--card:#0f1c35;--border:#1a2d4a;--accent:#00e5ff;--accent2:#a855f7;--text:#dde6f5;--muted:#4a6a8a;--success:#22d3a5;--red:#f43f5e}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.orb{position:fixed;border-radius:50%;filter:blur(90px);opacity:.15;pointer-events:none}
.orb1{width:500px;height:500px;background:var(--accent);top:-150px;left:-100px;animation:float 8s ease-in-out infinite}
.orb2{width:400px;height:400px;background:var(--accent2);bottom:-100px;right:-100px;animation:float 8s ease-in-out infinite;animation-delay:3s}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-30px)}}
.container{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;max-width:920px;width:95%;background:var(--card);border:1px solid var(--border);border-radius:22px;overflow:hidden;box-shadow:0 40px 100px rgba(0,0,0,.6);animation:slideUp .7s cubic-bezier(.16,1,.3,1) both}
@keyframes slideUp{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:translateY(0)}}
.left{background:linear-gradient(135deg,#0d1b35,#0a1628);padding:50px 40px;display:flex;flex-direction:column;justify-content:space-between}
.logo{font-family:'Syne',sans-serif;font-size:1.6rem;font-weight:800;background:linear-gradient(90deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.logo-sub{font-size:.72rem;color:var(--muted);margin-top:3px}
.hero-title{font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;line-height:1.2;margin-bottom:12px}
.hero-title span{background:linear-gradient(90deg,var(--accent),#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-desc{color:var(--muted);font-size:.88rem;line-height:1.6;margin-bottom:24px}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{background:rgba(0,229,255,.06);border:1px solid rgba(0,229,255,.15);border-radius:10px;padding:12px 14px}
.stat-val{font-family:'Syne',sans-serif;font-size:1.4rem;font-weight:800;color:var(--accent)}
.stat-label{font-size:.72rem;color:var(--muted);margin-top:2px}
.right{padding:50px 40px;display:flex;flex-direction:column;justify-content:center}
.form-title{font-family:'Syne',sans-serif;font-size:1.5rem;font-weight:800;margin-bottom:5px}
.form-sub{color:var(--muted);font-size:.86rem;margin-bottom:24px}
.role-row{display:flex;gap:8px;margin-bottom:22px}
.role-btn{flex:1;padding:10px;background:transparent;border:1px solid var(--border);border-radius:9px;color:var(--muted);font-family:'Plus Jakarta Sans',sans-serif;font-size:.8rem;cursor:pointer;transition:all .2s}
.role-btn.active{background:rgba(0,229,255,.1);border-color:var(--accent);color:var(--accent)}
label{display:block;font-size:.76rem;color:var(--muted);margin-bottom:5px}
input{width:100%;padding:12px 14px;background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:'Plus Jakarta Sans',sans-serif;font-size:.9rem;outline:none;transition:border-color .2s}
input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(0,229,255,.1)}
.otp-row{display:flex;gap:8px;align-items:flex-end;margin-bottom:14px}
.otp-row input{flex:1;margin-bottom:0}
.send-btn{padding:12px 16px;background:rgba(0,229,255,.1);border:1px solid rgba(0,229,255,.3);border-radius:10px;color:var(--accent);font-family:'Plus Jakarta Sans',sans-serif;font-size:.8rem;cursor:pointer;white-space:nowrap}
.send-btn:hover{background:rgba(0,229,255,.2)}
.otp-boxes{display:flex;gap:8px;margin-bottom:16px}
.otp-boxes input{flex:1;text-align:center;font-size:1.3rem;font-family:'Syne',sans-serif;font-weight:700;padding:12px 6px}
.main-btn{width:100%;padding:14px;background:linear-gradient(135deg,var(--accent),var(--accent2));border:none;border-radius:12px;color:#fff;font-family:'Syne',sans-serif;font-size:.95rem;font-weight:700;cursor:pointer;transition:transform .2s,box-shadow .2s;margin-top:6px}
.main-btn:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(0,229,255,.3)}
.divider{display:flex;align-items:center;gap:10px;margin:18px 0;color:var(--muted);font-size:.78rem}
.divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--border)}
.demo-btn{width:100%;padding:12px;border:none;border-radius:10px;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:.84rem;font-weight:600;cursor:pointer;margin-bottom:8px;transition:opacity .2s}
.demo-btn:hover{opacity:.85}
.bottom-link{text-align:center;font-size:.82rem;color:var(--muted);margin-top:14px}
.bottom-link a{color:var(--accent);text-decoration:none;font-weight:600}
.hidden{display:none}
@media(max-width:680px){.container{grid-template-columns:1fr}.left{display:none}.right{padding:36px 24px}}
</style>
</head>
<body>
<div class="orb orb1"></div><div class="orb orb2"></div>
<div class="container">
  <div class="left">
    <div><div class="logo">InternHub</div><div class="logo-sub">India's #1 Internship Platform</div></div>
    <div>
      <div class="hero-title">Launch Your<br><span>Career Journey</span><br>Today</div>
      <div class="hero-desc">Connect with 5000+ companies. Find internships matching your skills from REC and beyond.</div>
      <div class="stats">
        <div class="stat"><div class="stat-val">12K+</div><div class="stat-label">Active Internships</div></div>
        <div class="stat"><div class="stat-val">5K+</div><div class="stat-label">Companies</div></div>
        <div class="stat"><div class="stat-val">98%</div><div class="stat-label">Placement Rate</div></div>
        <div class="stat"><div class="stat-val">50K+</div><div class="stat-label">Students Placed</div></div>
      </div>
    </div>
    <div style="color:var(--muted);font-size:.72rem">© 2025 InternHub · All rights reserved</div>
  </div>
  <div class="right">
    <div class="form-title">Welcome Back 👋</div>
    <div class="form-sub">Sign in with your mobile number using OTP</div>
    <div class="role-row">
      <button class="role-btn active" onclick="setRole('student',this)">🎓 Student</button>
      <button class="role-btn" onclick="setRole('company',this)">🏢 Company</button>
      <button class="role-btn" onclick="setRole('admin',this)">🛡️ Admin</button>
    </div>
    <div id="phoneStep">
      <label>Mobile Number</label>
      <div class="otp-row">
        <input type="tel" id="phoneInput" placeholder="+91 98765 43210"/>
        <button class="send-btn" onclick="sendOTP()">Send OTP</button>
      </div>
      <div id="recaptcha-container"></div>
    </div>
    <div id="otpStep" class="hidden">
      <label>Enter 6-digit OTP sent to <span id="dispPhone" style="color:var(--accent)"></span></label>
      <div class="otp-boxes">
        <input type="text" maxlength="1" class="otp-d" oninput="otpNext(this,0)"/>
        <input type="text" maxlength="1" class="otp-d" oninput="otpNext(this,1)"/>
        <input type="text" maxlength="1" class="otp-d" oninput="otpNext(this,2)"/>
        <input type="text" maxlength="1" class="otp-d" oninput="otpNext(this,3)"/>
        <input type="text" maxlength="1" class="otp-d" oninput="otpNext(this,4)"/>
        <input type="text" maxlength="1" class="otp-d" oninput="otpNext(this,5)"/>
      </div>
      <button class="main-btn" onclick="verifyOTP()">✓ Verify & Login</button>
      <div style="text-align:center;margin-top:10px;font-size:.8rem;color:var(--muted)"><a href="#" style="color:var(--accent)" onclick="backToPhone()">← Change number</a></div>
    </div>
    <div class="divider">or demo login</div>
    <button class="demo-btn" style="background:linear-gradient(135deg,#10b981,#059669)" onclick="demoLogin('student')">→ Enter as Student (Vandana)</button>
    <button class="demo-btn" style="background:linear-gradient(135deg,#f59e0b,#d97706)" onclick="demoLogin('company')">→ Enter as Company</button>
    <button class="demo-btn" style="background:linear-gradient(135deg,#ef4444,#dc2626)" onclick="demoLogin('admin')">→ Enter as Admin</button>
    <div class="bottom-link">New here? <a href="register.html">Create account →</a></div>
  </div>
</div>
<script>
let role='student';
function setRole(r,btn){role=r;document.querySelectorAll('.role-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active')}
function sendOTP(){
  const p=document.getElementById('phoneInput').value.trim();
  if(!p){alert('Enter mobile number');return}
  document.getElementById('dispPhone').textContent=p;
  document.getElementById('phoneStep').classList.add('hidden');
  document.getElementById('otpStep').classList.remove('hidden');
}
function backToPhone(){document.getElementById('phoneStep').classList.remove('hidden');document.getElementById('otpStep').classList.add('hidden')}
function verifyOTP(){
  const otp=Array.from(document.querySelectorAll('.otp-d')).map(d=>d.value).join('');
  if(otp.length<6){alert('Enter all 6 digits');return}
  const pages={student:'student-dashboard.html',company:'company-dashboard.html',admin:'admin-dashboard.html'};
  window.location.href=pages[role];
}
function demoLogin(r){
  const pages={student:'student-dashboard.html',company:'company-dashboard.html',admin:'admin-dashboard.html'};
  window.location.href=pages[r];
}
function otpNext(inp,idx){if(inp.value&&idx<5)document.querySelectorAll('.otp-d')[idx+1].focus()}
</script>
</body>
</html>
